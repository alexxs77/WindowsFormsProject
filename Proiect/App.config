<configuration>
	<connectionStrings>
		<add name="Database1"
		connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\Database1.mdf;Integrated Security=True;Connect Timeout=30"
		providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
</configuration>